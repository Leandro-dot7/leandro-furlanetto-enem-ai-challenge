# Porta em que o servidor Express irá escutar
PORT=3000

# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui

# URL do frontend permitida pelo CORS (Vite dev server padrão)
CORS_ORIGIN=http://localhost:5173

# (Opcional) URI de conexão com MongoDB — se não informado, o MongoDB é ignorado
# MONGODB_URI=mongodb://localhost:27017/minerva
